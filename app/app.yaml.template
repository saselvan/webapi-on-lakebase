# WebAPI app: the app's service principal through PgBouncer 1.26.1 + refresher in the app (APP_DB=pgbouncer).
# tools/render.py renders it into the staging folder (outside the repo); the Lakebase host never enters the repo.
# No native-login password and no Lakebase JDBC URL: WebAPI reaches Lakebase only through 127.0.0.1:6432.
# Secrets: app resources pgb-local-password (WebAPI -> PgBouncer only) and webapi-jasypt-key
# Secret webapi-bridge-secret: the bridge's WebAPI DB-login secret (made new by tools/setup_and_deploy.sh).
# WebAPI security is ON: the Apps proxy signs users in with workspace SSO; app/bridge.py maps X-Forwarded-Email
# to a WebAPI DB login. The launcher builds the DB-login query from a new bcrypt hash of BRIDGE_SECRET, so no hash
# and no secret is in this file. tools/setup_and_deploy.sh attaches the secrets from SECRET_SCOPE.
# DATABRICKS_CLIENT_ID / _SECRET / _HOST are injected by Databricks Apps (the app's service principal).
command: ["python", "launcher.py"]
env:
  - {name: APP_DB, value: pgbouncer}
  - {name: LAKEBASE_HOST, value: "__LAKEBASE_HOST__"}
  - {name: LAKEBASE_ENDPOINT, value: "__LAKEBASE_ENDPOINT__"}
  - {name: PGB_LOCAL_PASSWORD, valueFrom: pgb-local-password}
  - {name: PGB_REFRESH_S, value: "900"}
  - {name: PGB_SHA256, value: "__PGB_SHA256__"}
  - {name: JASYPT_ENCRYPTOR_PASSWORD, valueFrom: webapi-jasypt-key}
  - {name: SOURCE_KEY, value: "__SOURCE_KEY__"}
  - {name: TICK_CONCEPT_ID, value: "__TICK_CONCEPT_ID__"}
  - {name: DATASOURCE_DRIVERCLASSNAME, value: org.postgresql.Driver}
  - {name: DATASOURCE_USERNAME, value: webapi}
  - {name: DATASOURCE_OHDSI_SCHEMA, value: __WEBAPI_SCHEMA__}
  - {name: SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT, value: org.hibernate.dialect.PostgreSQLDialect}
  - {name: SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA, value: __WEBAPI_SCHEMA__}
  - {name: SPRING_BATCH_REPOSITORY_TABLEPREFIX, value: __WEBAPI_SCHEMA__.BATCH_}
  - {name: FLYWAY_DATASOURCE_DRIVERCLASSNAME, value: org.postgresql.Driver}
  - {name: FLYWAY_DATASOURCE_USERNAME, value: webapi}
  - {name: FLYWAY_LOCATIONS, value: "classpath:db/migration/postgresql"}
  - {name: FLYWAY_PLACEHOLDERS_OHDSISCHEMA, value: __WEBAPI_SCHEMA__}
  - {name: FLYWAY_SCHEMAS, value: __WEBAPI_SCHEMA__}
  - {name: FLYWAY_BASELINE_ON_MIGRATE, value: "true"}
  - {name: FLYWAY_TABLE, value: schema_history}
  - {name: flyway_baselineVersionAsString, value: "2.2.5.20180212152023"}
  - {name: FLYWAY_BASELINEDESCRIPTION, value: Base Migration}
  - {name: SECURITY_PROVIDER, value: AtlasRegularSecurity}
  - {name: SECURITY_AUTH_JDBC_ENABLED, value: "true"}
  - {name: SECURITY_AUTH_WINDOWS_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_KERBEROS_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_OPENID_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_FACEBOOK_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_GITHUB_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_GOOGLE_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_LDAP_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_AD_ENABLED, value: "false"}
  - {name: SECURITY_AUTH_CAS_ENABLED, value: "false"}
  - {name: SECURITY_DEFAULTGLOBALREADPERMISSIONS, value: "false"}
  - {name: SECURITY_DB_DATASOURCE_DRIVERCLASSNAME, value: org.postgresql.Driver}
  - {name: SECURITY_DB_DATASOURCE_USERNAME, value: webapi}
  - {name: SECURITY_DB_DATASOURCE_SCHEMA, value: __WEBAPI_SCHEMA__}
  - {name: SECURITY_ORIGIN, value: "__APP_URL__"}
  - {name: APP_BRIDGE, value: "on"}
  - {name: BRIDGE_SECRET, valueFrom: webapi-bridge-secret}
  - {name: OPS_ADMINS, value: "__OPS_ADMINS__"}
  - {name: OPS_CONTROL, value: "__OPS_CONTROL__"}
  - {name: SOLR_ENDPOINT, value: ""}
  - {name: JASYPT_ENCRYPTOR_ENABLED, value: "true"}
  - {name: JASYPT_ENCRYPTOR_ALGORITHM, value: "PBEWITHSHA256AND128BITAES-CBC-BC"}
  - {name: LOGGING_LEVEL_ROOT, value: info}
  - {name: LOGGING_LEVEL_ORG_OHDSI, value: info}
