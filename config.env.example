# Copy to config.env (git ignores it) and fill in. Read by tools/render.py, tools/setup_and_deploy.sh,
# tools/register_source.py and tools/teardown.sh. KEY=value only; comments on their own line.

# Databricks CLI profile to use. Required: no script picks one for you.
DATABRICKS_PROFILE=
# Databricks App name (create it first: databricks apps create <name> --profile <profile>).
APP_NAME=
# Lakebase endpoint: projects/<project>/branches/<branch>/endpoints/<endpoint>
LAKEBASE_ENDPOINT=
# Its host: databricks postgres get-endpoint <endpoint> --profile <profile> -o json  (status.hosts.host)
LAKEBASE_HOST=
# New, empty schema for WebAPI's own tables (Flyway creates it, owned by the app's service principal).
WEBAPI_SCHEMA=webapi
# Existing schema with your OMOP vocabulary tables or views on Lakebase.
VOCAB_SCHEMA=
# Secret scope for the two app secrets (created if missing).
SECRET_SCOPE=webapi-app
# WebAPI source key you register with tools/register_source.py.
SOURCE_KEY=VOCAB
# Optional: one concept id the in-app ticker opens on SOURCE_KEY every 60 s. Empty = skip that path.
TICK_CONCEPT_ID=
# Your static PgBouncer binary (pgbouncer/Dockerfile.static) and ITS SHA-256: shasum -a 256 <file>
# This is the hash of the binary you built, not the hash of the PgBouncer source tarball.
PGB_BINARY=
PGB_SHA256=
# Optional: your queries.json for the in-app load runner (a JSON list of URL-encoded search strings). Empty = no runner.
QUERIES_JSON=
# Optional: staging folder outside the repo. Default ~/.webapi-on-lakebase/stage
STAGE_DIR=
